# WAHA
WAHA_BASE_URL=http://localhost:3000
WAHA_API_KEY=
WAHA_SESSION=default

# Upload target: s3 | temp | gdrive | both | all | comma-separated (e.g. temp,gdrive)
# - s3: upload to Cloudflare R2 / S3-compatible storage only (default)
# - temp: upload to temp.sh only
# - gdrive: upload to Google Drive only
# - both: alias for s3,temp
# - all: alias for s3,temp,gdrive
UPLOAD_TARGET=s3
# Alternative to UPLOAD_TARGET (used when UPLOAD_TARGET is unset/empty):
# UPLOAD_S3=true
# UPLOAD_TEMP=true
# UPLOAD_GDRIVE=true
# Optional: temp file upload endpoint (default: https://temp.sh/upload)
TEMP_UPLOAD_URL=https://temp.sh/upload

# Google Drive (required when UPLOAD_TARGET includes gdrive or all)
# Option 1: OAuth2 Refresh Token (recommended for personal Google Drive)
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
# Option 2: Service Account (recommended for Google Workspace Shared Drives)
# GDRIVE_SERVICE_ACCOUNT_JSON=
# GDRIVE_CLIENT_EMAIL=
# GDRIVE_PRIVATE_KEY=
# Optional: target Google Drive folder ID
GDRIVE_FOLDER_ID=
# Optional: share uploaded file as "anyone with the link" (default: true)
GDRIVE_PUBLIC=true

# Cloudflare R2 (S3-compatible, required when UPLOAD_TARGET is s3 or both)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=waha-downloader
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: if set, skips presigned URLs and uses this public/CDN base URL instead
R2_PUBLIC_BASE_URL=
# Optional: presigned URL TTL in seconds (default: 3600)
R2_PRESIGN_TTL_SECONDS=3600

# Downloader & Storage
# Optional: max concurrent yt-dlp downloads (default: 2)
DOWNLOAD_CONCURRENCY=2
# Optional: yt-dlp idle timeout in seconds without output (default: 300 = 5 minutes)
DOWNLOAD_TIMEOUT_SECONDS=300
# Optional: completed download cache TTL in seconds (default: auto based on upload target; 0 disables)
# DOWNLOAD_CACHE_TTL_SECONDS=3600
# Optional: max video size in bytes to send directly via WhatsApp (default: 52428800 = 50 MiB)
MAX_WHATSAPP_MEDIA_BYTES=52428800
# Optional: temporary working directory (default: tmp)
TMP_DIR=tmp
# Optional: directory for per-Requester Cookie Profiles (default: ./cookies)
COOKIES_DIR=./cookies
# Optional: persistent JSON file for per-Requester Auto-Download settings (default: ./data/autodownload.json)
AUTODL_FILE=./data/autodownload.json
