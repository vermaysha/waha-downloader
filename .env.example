# WAHA
WAHA_BASE_URL=http://localhost:3000
WAHA_API_KEY=
WAHA_SESSION=default

# Cloudflare R2 (S3-compatible)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=waha-downloader
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: if set, skips presigned URLs and uses this public/CDN base URL instead
R2_PUBLIC_BASE_URL=
# Optional: presigned URL TTL in seconds (default: 3600)
R2_PRESIGN_TTL_SECONDS=3600

# Downloader & Storage
# Optional: max concurrent yt-dlp downloads (default: 2)
DOWNLOAD_CONCURRENCY=2
# Optional: max video size in bytes to send directly via WhatsApp (default: 52428800 = 50 MiB)
MAX_WHATSAPP_MEDIA_BYTES=52428800
# Optional: temporary working directory (default: tmp)
TMP_DIR=tmp
# Optional: directory for per-Requester Cookie Profiles (default: ./cookies)
COOKIES_DIR=./cookies
